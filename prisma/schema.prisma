// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // ← Eliminamos la línea de url de aquí
}

// ======================
// MODELOS PRINCIPALES
// ======================

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String
  firstName   String?
  lastName    String?
  avatarUrl   String?
  role        UserRole @default(ORGANIZER)

  events      Event[]
  auditLogs   AuditLog[] // 🌟 Relación añadida para tener el historial del usuario
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id                 String    @id @default(cuid())
  slug               String    @unique
  eventNumber        String    @unique
  name               String
  description        String?
  date               DateTime
  endDate            DateTime?
  location           String?
  locationUrl        String?
  bannerUrl          String?

  isPublic           Boolean   @default(true)
  accessCode         String?
  capacity           Int?
  isActive           Boolean   @default(false)
  paymentStatus      String    @default("PENDING")
  paymentAmount      Decimal?
  deactivationReason String?
  activatedAt        DateTime?
  paymentMethod      String?
  paymentNotes       String?

  userId             String
  user               User      @relation(fields: [userId], references: [id])
  attendees          Attendee[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ==================== CAMPOS PARA ARCHIVADO ====================
  archived           Boolean   @default(false)
  archivedAt         DateTime?
  // ============================================================
}

enum UserRole {
  ORGANIZER
  SUPER_ADMIN
}

model Attendee {
  id          String         @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  
  qrCode      String         @unique
  status      AttendeeStatus @default(REGISTERED)
  checkedInAt DateTime?
  notes       String?

  eventId     String
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([email, eventId])
  @@map("attendees")
}

enum AttendeeStatus {
  REGISTERED
  CHECKED_IN
  CANCELLED
}

// ============================================================
// 🌟 NUEVO MODELO DE AUDITORÍA TOTAL
// ============================================================
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // Ej: "EVENT_CREATE", "EVENT_UPDATE", "EVENT_DELETE", "ATTENDEE_REGISTER", "CHECKIN"
  entity      String   // Ej: "EVENT", "ATTENDEE"
  entityId    String?  // El ID del evento o asistente afectado
  userId      String?  // ID interno de nuestro usuario (si aplica)
  userEmail   String?  // Email de respaldo por si el usuario es removido
  ipAddress   String?  // Dirección IP (crucial para auditorías de registros y prevención de fraudes)
  details     String?  // Notas detalladas en texto libre o un stringificado de JSON
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity, entityId])
}